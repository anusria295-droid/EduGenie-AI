# ---------------------------------------------------------
# EduGenie Environment Configuration
# ---------------------------------------------------------

# Your Google Gemini API key
GEMINI_API_KEY=your_api_key_here

# Gemini model available in your Google AI Studio account
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------
# Optional Local Explanation Model
# ---------------------------------------------------------

# false = use Gemini for explanations
# true  = try using local LaMini model
USE_LOCAL_EXPLAINER=false

LOCAL_EXPLAINER_MODEL=MBZUAI/LaMini-Flan-T5-783M